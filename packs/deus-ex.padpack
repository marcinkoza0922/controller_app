[[info_overlays]]
name = "Controls"
title = "This game's controls"
always = false
rows = [
    [
    "{ls}",
    "Move (half push: walk)",
    "{rs}",
    "Look",
],
    [
    "{rt}",
    "Fire",
    "{lt}",
    "Scope",
],
    [
    "{south}",
    "Jump",
    "{east}",
    "Use",
],
    [
    "{west}",
    "Reload · hold: change ammo",
    "{north}",
    "Inventory",
],
    [
    "{lb}",
    "Hold: belt · double tap: holster",
    "{rb}",
    "Hold: augmentations",
],
    [
    "{l3}",
    "Click: crouch (toggle)",
    "{r3}",
    "Click: laser sight",
],
    [
    "{left} {right}",
    "Lean",
    "{down}",
    "Drop / throw",
],
    [
    "{guide}",
    "Hold: system shortcuts",
    "{select}",
    "Goals",
],
    [
    "{start}",
    "Menu · double tap: quick save",
    "hold {start}",
    "Quick load",
],
]

[info_overlays.style]
position = "center"
scale = 0.9

[info_overlays.style.background]
color = "#07142b"
opacity = 0.88

[info_overlays.style.items]
color = "#17375f"
opacity = 0.95

[info_overlays.style.selected]
color = "#3d8bff"
opacity = 1.0

[[layers]]
name = "Guide"
indicator = "bindings"
indicator_title = "Hold {guide} and press"
indicator_delay_ms = 100
swallow_unbound = true

[layers.buttons]
East = "force_quit"
LeftStick = "toggle_recording"
RightBumper = "screenshot"
LeftBumper = "toggle_media"
West = "toggle_overlay"
North = "toggle_numpad"

[layers.buttons.DpadRight]
keys = ["KEY_ENTER"]

[layers.buttons.DpadDown]
keys = ["KEY_TAB"]

[layers.buttons.DpadLeft]
keys = ["KEY_ESC"]

[layers.right_stick]
deadzone = 0.1
curve = 2.0
key_threshold = 0.5

[layers.right_stick.action.mouse]
speed = 1600.0

[layers.left_trigger.action.button]
threshold = 0.3

[layers.left_trigger.action.button.action]
mouse = "Right"

[layers.right_trigger.action.button]
threshold = 0.3

[layers.right_trigger.action.button.action]
mouse = "Left"

