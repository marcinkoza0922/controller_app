pick = { kind = "clink", volume = 0.3, pitch = 0.8, length = 1.2 }

[sounds.media]
step = { kind = "blip", volume = 0.05, pitch = 1.2 }
pick = { kind = "clink", volume = 0.24, pitch = 1.0 }

[sounds.offer]
step = { kind = "blip", volume = 0.06, pitch = 0.9 }
pick = { kind = "clink", volume = 0.3, pitch = 0.8, length = 1.3 }

[motion]
keyboard = "stagger"
