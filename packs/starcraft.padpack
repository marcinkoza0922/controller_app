],
]

[info_overlays.style]
position = "center"
scale = 0.9

[info_overlays.style.background]
color = "#0b1624"
opacity = 0.9

[info_overlays.style.items]
color = "#1c2b40"
opacity = 0.95

[info_overlays.style.selected]
color = "#2fa4e7"
opacity = 1.0
