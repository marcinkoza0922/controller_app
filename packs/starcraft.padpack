format = 13
macros = []
overlay_font = "Rajdhani"

[pack]
id = "61b6cfbf-9932-4091-89e9-6cf0f6fa5a6e"
name = "StarCraft"
version = "1.1"
author = "padwight"
description = "StarCraft: Remastered (Battle.net) on an Xbox-style pad, for the default hotkeys. Left stick moves the cursor, RT left-clicks, LT right-clicks, right stick scrolls the map. Face buttons are Attack / Cancel / Stop / Hold, the d-pad is Move / Patrol / Basic and Advanced structures, RB is Shift (queue). Hold LB for control groups 1-8 (also hold RB in there to assign the group instead), R3 opens a radial menu of worker and unit commands. Start is the game menu, Select jumps to the last alert, Guide + X opens the on-screen keyboard (profile names, chat); hold Guide to see every control and the system shortcuts. Holding Select switches the Menus layer on and off (face buttons click and confirm, the d-pad presses the arrows, the right stick scrolls). The \"Gameplay + Gyro\" profile also moves the cursor by tilting the controller, as a fine pointer next to the left stick. Unit-specific keys (siege, cloak, burrow...) aren't mapped; add them to the radial menu if you want them."
made_with = "Xbox controller"

[[rules]]
kind = "executable"
value = "StarCraft.exe"
profile = "Gameplay"

[[profiles]]
name = "Gameplay"
combos = []
combo_window_ms = 120
tap_window_ms = 250
long_press_ms = 500

[profiles.buttons.South]
keys = ["KEY_A"]

[profiles.buttons.East]
keys = ["KEY_ESC"]

[profiles.buttons.North]
keys = ["KEY_H"]

[profiles.buttons.West]
keys = ["KEY_S"]

[profiles.buttons.LeftBumper]
layer = "Groups"

[profiles.buttons.RightBumper]
keys = ["KEY_LEFTSHIFT"]

[profiles.buttons.Select]
keys = ["KEY_SPACE"]

[profiles.buttons.Start]
keys = ["KEY_F10"]

[profiles.buttons.Guide]
multi = [
    { layer = "Guide" },
    { show_info = "Controls" },
]

[profiles.buttons.LeftStick]
multi = [
    { keys = ["KEY_LEFTCTRL"] },
    { mouse = "Left" },
]

[profiles.buttons.RightStick]
open_menu = "Commands"

[profiles.buttons.DpadUp]
keys = ["KEY_M"]

[profiles.buttons.DpadDown]
keys = ["KEY_V"]

[profiles.buttons.DpadLeft]
keys = ["KEY_B"]

[profiles.buttons.DpadRight]
keys = ["KEY_P"]

[profiles.left_stick]
deadzone = 0.1
curve = 1.6
key_threshold = 0.25

[profiles.left_stick.action.mouse]
speed = 1500.0
accel = 0.25

[profiles.right_stick]
deadzone = 0.2
curve = 1.0
key_threshold = 0.45

[profiles.right_stick.action.keys]
up = "KEY_UP"
down = "KEY_DOWN"
left = "KEY_LEFT"
right = "KEY_RIGHT"

[profiles.left_trigger.action.button]
threshold = 0.4

[profiles.left_trigger.action.button.action]
mouse = "Right"

[profiles.right_trigger.action.button]
threshold = 0.3

[profiles.right_trigger.action.button.action]
mouse = "Left"

[profiles.gestures.Select.long_press.toggle]
layer = "Menus"

[profiles.gestures.Guide.double_tap]
gamepad = "Guide"

[profiles.gyro]
mode = "off"
horizontal = "yaw"
invert_x = false
invert_y = false
activation = "always"
noise_threshold = 1.0

[[profiles]]
name = "Gameplay + Gyro"
combos = []
combo_window_ms = 120
tap_window_ms = 250
long_press_ms = 500

[profiles.buttons.South]
keys = ["KEY_A"]

[profiles.buttons.East]
keys = ["KEY_ESC"]

[profiles.buttons.North]
keys = ["KEY_H"]

[profiles.buttons.West]
keys = ["KEY_S"]

[profiles.buttons.LeftBumper]
layer = "Groups"

[profiles.buttons.RightBumper]
keys = ["KEY_LEFTSHIFT"]

[profiles.buttons.Select]
keys = ["KEY_SPACE"]

[profiles.buttons.Start]
keys = ["KEY_F10"]

[profiles.buttons.Guide]
multi = [
    { layer = "Guide" },
    { show_info = "Controls" },
]

[profiles.buttons.LeftStick]
multi = [
    { keys = ["KEY_LEFTCTRL"] },
    { mouse = "Left" },
]

[profiles.buttons.RightStick]
open_menu = "Commands"

[profiles.buttons.DpadUp]
keys = ["KEY_M"]

[profiles.buttons.DpadDown]
keys = ["KEY_V"]

[profiles.buttons.DpadLeft]
keys = ["KEY_B"]

[profiles.buttons.DpadRight]
keys = ["KEY_P"]

[profiles.left_stick]
deadzone = 0.1
curve = 1.6
key_threshold = 0.25

[profiles.left_stick.action.mouse]
speed = 1500.0
accel = 0.25

[profiles.right_stick]
deadzone = 0.2
curve = 1.0
key_threshold = 0.45

[profiles.right_stick.action.keys]
up = "KEY_UP"
down = "KEY_DOWN"
left = "KEY_LEFT"
right = "KEY_RIGHT"

[profiles.left_trigger.action.button]
threshold = 0.4

[profiles.left_trigger.action.button.action]
mouse = "Right"

[profiles.right_trigger.action.button]
threshold = 0.3

[profiles.right_trigger.action.button.action]
mouse = "Left"

[profiles.gestures.Select.long_press.toggle]
layer = "Menus"

[profiles.gestures.Guide.double_tap]
gamepad = "Guide"

[profiles.gyro]
activation = "always"
horizontal = "yaw"
invert_x = false
invert_y = false
noise_threshold = 1.0

[profiles.gyro.mode.mouse]
sensitivity = 20.0

[[menus]]
name = "Commands"

[menus.kind.radial]
stick = "Right"

[[menus.items]]
label = "Gather"

[menus.items.action]
keys = ["KEY_G"]

[[menus.items]]
label = "Return cargo"

[menus.items.action]
keys = ["KEY_C"]

[[menus.items]]
label = "Repair"

[menus.items.action]
keys = ["KEY_R"]

[[menus.items]]
label = "Rally point"

[menus.items.action]
keys = ["KEY_Y"]

[[menus.items]]
label = "Load"

[menus.items.action]
keys = ["KEY_L"]

[[menus.items]]
label = "Unload all"

[menus.items.action]
keys = ["KEY_D"]

[menus.style]
corners = 0.5
position = "center"
scale = 1.0

[menus.style.background]
color = "#0a171b"
opacity = 0.9

[menus.style.items]
color = "#163238"
opacity = 0.95

[menus.style.selected]
color = "#3fc1b4"
opacity = 1.0

