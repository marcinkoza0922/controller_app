    "{up}",
    "Move",
    "{right}",
    "Patrol",
],
    [
    "{left}",
    "Basic structures",
    "{down}",
    "Advanced structures",
],
    [
    "{rb}",
    "Shift (queue)",
    "{l3}",
    "Click: ctrl-click (select same type)",
],
    [
    "{lb}",
    "Hold: control groups 1-8",
