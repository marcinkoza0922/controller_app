],
    [
    "{rt}",
    "Left click (select)",
    "{lt}",
    "Right click (move / target)",
],
    [
    "{south}",
    "Attack",
    "{east}",
    "Cancel",
],
    [
    "{west}",
    "Stop",
    "{north}",
    "Hold position",
],
