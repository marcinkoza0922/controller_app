format = 13
macros = []

[pack]
id = "3080b330-addd-4812-99c5-bd116fa913db"
name = "RollerCoaster Tycoon"
version = "1.0"
author = "Padwight"
description = "RollerCoaster Tycoon (Deluxe, Windows build run through Heroic or Proton) on an Xbox-style pad. Left stick scrolls the map with the arrow keys, the right stick moves the cursor, A and RT left-click, LT right-click, B is Escape. Start pauses. Hold LB for a radial menu of Pause and Close window. This is a starting point: check the bindings against the game's own keys."
made_with = "Xbox controller"

[[rules]]
kind = "executable"
value = "RCT.EXE"
profile = "RollerCoaster Tycoon"

[[profiles]]
name = "RollerCoaster Tycoon"
combos = []
combo_window_ms = 120
tap_window_ms = 250
long_press_ms = 500

[profiles.buttons]

[profiles.buttons.Guide]
layer = "Guide"

[profiles.buttons.South]
mouse = "Left"

[profiles.buttons.East]
keys = ["KEY_ESC"]

[profiles.buttons.Start]
keys = ["KEY_P"]

[profiles.buttons.LeftBumper]
open_menu = "Tools"

[profiles.left_stick]
deadzone = 0.12
curve = 1.0
key_threshold = 0.3

[profiles.left_stick.action.keys]
up = "KEY_UP"
down = "KEY_DOWN"
left = "KEY_LEFT"
right = "KEY_RIGHT"

[profiles.right_stick]
deadzone = 0.15
curve = 1.6

[profiles.right_stick.action.mouse]
speed = 1400.0

[profiles.left_trigger.action.button]
threshold = 0.4

[profiles.left_trigger.action.button.action]
mouse = "Right"

[profiles.right_trigger.action.button]
threshold = 0.3

[profiles.right_trigger.action.button.action]
mouse = "Left"

[profiles.gyro]
mode = "off"
horizontal = "yaw"
invert_x = false
invert_y = false
activation = "always"
noise_threshold = 1.0

[[menus]]
name = "Tools"

[menus.kind.radial]
stick = "Right"

[[menus.items]]
label = "Pause"
weight = 1.5

[menus.items.action]
keys = ["KEY_P"]

[[menus.items]]
label = "Close window"
weight = 1.0

[menus.items.action]
keys = ["KEY_ESC"]

[menus.style]
position = "center"
scale = 1.0
corners = 0.9

[menus.style.background]
color = "#1b2b1f"
opacity = 0.92

[menus.style.items]
color = "#2f5b3a"
opacity = 0.95

[menus.style.selected]
color = "#f2c94c"
opacity = 1.0

