[[menus]]
name = "Weapons"

[menus.kind.radial]
stick = "Right"

[[menus.items]]
label = "Weapon 1"

[menus.items.action]
keys = ["KEY_1"]

[[menus.items]]
label = "Weapon 2"

[menus.items.action]
keys = ["KEY_2"]

[[menus.items]]
label = "Weapon 3"

[menus.items.action]
keys = ["KEY_3"]

[[menus.items]]
label = "Grenade 4"

[menus.items.action]
keys = ["KEY_4"]

[[menus.items]]
label = "Grenade 5"

[menus.items.action]
keys = ["KEY_5"]

[[menus.items]]
label = "Grenade 6"

[menus.items.action]
keys = ["KEY_6"]

[[menus.items]]
label = "Holster"

[menus.items.action]
keys = ["KEY_H"]

[[menus.items]]
label = "Drop weapon"

[menus.items.action]
keys = ["KEY_B"]

[menus.style]
corners = 0.3
position = "center"
scale = 1.0

[menus.style.background]
color = "#111a14"
opacity = 0.92

[menus.style.items]
color = "#25332a"
opacity = 0.95

[menus.style.selected]
color = "#7d9a72"
opacity = 1.0
