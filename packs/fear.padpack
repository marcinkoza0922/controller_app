format = 6
macros = []
overlay_font = "Rajdhani"

[pack]
id = "440bc3de-a490-4318-b4d5-b11e53597dfe"
name = "F.E.A.R."
version = "1.1"
author = "controller_app"
description = "F.E.A.R. (2005) and its expansions on an Xbox-style pad, for the game's default keys. Hold LB for a radial menu of weapons, grenade types, holster and drop (aim with the right stick); RB triggers slow-mo, LT zooms, R3 is melee, L3 toggles crouch. Start + Select shows every control."
made_with = "Xbox controller"
requires = []

[[rules]]
kind = "executable"
value = "FEAR.exe"
profile = "F.E.A.R."

[[rules]]
kind = "executable"
value = "FEARXP.exe"
profile = "F.E.A.R."

[[rules]]
kind = "executable"
value = "FEARXP2.exe"
profile = "F.E.A.R."

[[rules]]
kind = "steam_app_id"
value = "21090"
profile = "F.E.A.R."

[[profiles]]
name = "F.E.A.R."
combo_window_ms = 120
tap_window_ms = 250
long_press_ms = 500

[profiles.buttons]
Guide = "next_profile"

[profiles.buttons.South]
keys = ["KEY_SPACE"]

[profiles.buttons.East]
keys = ["KEY_F"]

[profiles.buttons.North]
keys = ["KEY_G"]

[profiles.buttons.West]
keys = ["KEY_R"]

[profiles.buttons.LeftBumper]
open_menu = "Weapons"

[profiles.buttons.RightBumper]
keys = ["KEY_LEFTCTRL"]

[profiles.buttons.Select]
keys = ["KEY_TAB"]

[profiles.buttons.Start]
keys = ["KEY_ESC"]

[profiles.buttons.LeftStick.toggle]
keys = ["KEY_C"]

[profiles.buttons.RightStick]
mouse = "Right"

[profiles.buttons.DpadUp]
keys = ["KEY_X"]

[profiles.buttons.DpadDown]
keys = ["KEY_Z"]

[profiles.buttons.DpadLeft]
keys = ["KEY_Q"]

[profiles.buttons.DpadRight]
keys = ["KEY_E"]

[profiles.left_stick]
deadzone = 0.12
curve = 1.0
key_threshold = 0.25

[profiles.left_stick.action.keys]
up = "KEY_W"
down = "KEY_S"
left = "KEY_A"
right = "KEY_D"

[profiles.right_stick]
deadzone = 0.1
curve = 2.0
key_threshold = 0.5

[profiles.right_stick.action.mouse]
speed = 1100.0

[profiles.left_trigger.action.button]
threshold = 0.4

[profiles.left_trigger.action.button.action]
keys = ["KEY_LEFTSHIFT"]

[profiles.right_trigger.action.button]
threshold = 0.3

[profiles.right_trigger.action.button.action]
mouse = "Left"

[[profiles.combos]]
buttons = [
    "Start",
    "Select",
]

[profiles.combos.action]
show_info = "Controls"

[profiles.gestures.Start.double_tap]
keys = ["KEY_F5"]

[profiles.gestures.Start.long_press]
keys = ["KEY_F9"]

[profiles.gestures.Select.long_press]
keys = ["KEY_M"]

[profiles.gyro]
mode = "off"
horizontal = "yaw"
invert_x = false
invert_y = false
activation = "always"
noise_threshold = 1.0

[[menus]]
name = "Weapons"

[menus.kind.radial]
stick = "Right"

[[menus.items]]
label = "Weapon 1"

[menus.items.action]
keys = ["KEY_1"]

[[menus.items]]
label = "Weapon 2"

[menus.items.action]
keys = ["KEY_2"]

[[menus.items]]
label = "Weapon 3"

[menus.items.action]
keys = ["KEY_3"]

[[menus.items]]
label = "Grenade 4"

[menus.items.action]
keys = ["KEY_4"]

[[menus.items]]
label = "Grenade 5"

[menus.items.action]
keys = ["KEY_5"]

[[menus.items]]
label = "Grenade 6"

[menus.items.action]
keys = ["KEY_6"]

[[menus.items]]
label = "Holster"

[menus.items.action]
keys = ["KEY_H"]

[[menus.items]]
label = "Drop weapon"

[menus.items.action]
keys = ["KEY_B"]

[menus.style]
position = "center"
scale = 1.0

[menus.style.background]
color = "#16181c"
opacity = 0.92

[menus.style.items]
color = "#30343c"
opacity = 0.95

[menus.style.selected]
color = "#b02f2f"
opacity = 1.0

[[info_overlays]]
name = "Controls"
always = false
rows = [
    [
    "{ls}",
    "Move",
    "{rs}",
    "Look",
],
    [
    "{rt}",
    "Fire",
    "{lt}",
    "Zoom",
],
    [
    "{south}",
    "Jump",
    "{east}",
    "Use",
],
    [
    "{west}",
    "Reload",
    "{north}",
    "Throw grenade",
],
    [
    "{lb}",
    "Hold: weapons, grenades",
    "{rb}",
    "Slow-mo",
],
    [
    "{l3}",
    "Click: crouch (toggle)",
    "{r3}",
    "Click: melee",
],
    [
    "{left} {right}",
    "Lean",
    "{up}",
    "Flashlight",
],
    [
    "{down}",
    "Med kit",
    "{select}",
    "Status · hold: mission",
],
    [
    "{start}",
    "Menu · double tap: quick save",
    "hold {start}",
    "Quick load",
],
]

[info_overlays.style]
position = "center"
scale = 0.9

[info_overlays.style.background]
color = "#16181c"
opacity = 0.88

[info_overlays.style.items]
color = "#30343c"
opacity = 0.95

[info_overlays.style.selected]
color = "#b02f2f"
opacity = 1.0
