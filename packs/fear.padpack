opacity = 0.95

[menus.style.selected]
color = "#7d9a72"
opacity = 1.0

[[info_overlays]]
name = "Controls"
title = "This game's controls"
always = false
rows = [
    [
    "{ls}",
    "Move",
    "{rs}",
    "Look",
],
    [
    "{rt}",
    "Fire",
    "{lt}",
    "Zoom",
],
    [
    "{south}",
    "Jump",
    "{east}",
    "Use",
],
    [
    "{west}",
    "Reload",
    "{north}",
    "Throw grenade",
],
    [
    "{lb}",
    "Hold: weapons, grenades",
    "{rb}",
    "Slow-mo",
],
    [
    "{l3}",
    "Click: crouch (toggle)",
    "{r3}",
    "Click: melee",
],
    [
    "{left} {right}",
    "Lean",
    "{up}",
    "Flashlight",
],
    [
    "{down}",
    "Med kit",
    "{select}",
    "Status · hold: mission",
],
    [
    "{start}",
    "Menu · double tap: quick save",
    "hold {start}",
    "Quick load",
],
]

[info_overlays.style]
position = "center"
scale = 0.9

[info_overlays.style.background]
color = "#111a14"
opacity = 0.88

[info_overlays.style.items]
color = "#25332a"
opacity = 0.95

[info_overlays.style.selected]
color = "#7d9a72"
opacity = 1.0

[[layers]]
name = "Guide"
indicator = "bindings"
indicator_title = "Hold {guide} and press"
indicator_delay_ms = 250
swallow_unbound = true

[layers.buttons]
East = "force_quit"
LeftStick = "toggle_recording"
RightBumper = "screenshot"
LeftBumper = "toggle_media"
West = "toggle_overlay"
North = "toggle_numpad"
DpadUp = "next_profile"

[layers.buttons.DpadRight]
keys = ["KEY_ENTER"]

[layers.buttons.DpadDown]
keys = ["KEY_TAB"]

[layers.buttons.DpadLeft]
keys = ["KEY_ESC"]

[layers.right_stick]
deadzone = 0.1
curve = 2.0
key_threshold = 0.5

[layers.right_stick.action.mouse]
speed = 1600.0

[layers.left_trigger.action.button]
threshold = 0.3

[layers.left_trigger.action.button.action]
mouse = "Right"

[layers.right_trigger.action.button]
threshold = 0.3

[layers.right_trigger.action.button.action]
mouse = "Left"

