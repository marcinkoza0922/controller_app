[[menus]]
name = "Weapons"

[menus.kind.radial]
stick = "Right"

[[menus.items]]
label = "Melee"

[menus.items.action]
keys = ["KEY_1"]

[[menus.items]]
label = "Handguns"

[menus.items.action]
keys = ["KEY_2"]

[[menus.items]]
label = "Shotguns"

[menus.items.action]
keys = ["KEY_3"]

[[menus.items]]
label = "Automatic"

[menus.items.action]
keys = ["KEY_4"]

[[menus.items]]
label = "Throwables"

[menus.items.action]
keys = ["KEY_5"]

[[menus.items]]
label = "Sniper rifle"

[menus.items.action]
keys = ["KEY_6"]

[menus.style]
position = "center"
scale = 1.0

[menus.style.background]
color = "#101214"
opacity = 0.92

[menus.style.items]
color = "#2a2d31"
opacity = 0.95

[menus.style.selected]
color = "#c9a227"
opacity = 1.0

[[info_overlays]]
name = "Controls"
title = "This game's controls"
always = false
rows = [
    [
    "{ls}",
    "Move",
    "{rs}",
    "Aim",
],
    [
    "{lt}",
    "Bullet time",
    "{rb}",
    "Shoot-dodge (move + {rb})",
],
    [
    "{rt}",
    "Shoot",
    "{south}",
    "Jump",
],
    [
    "{east}",
    "Use · hold: sniper zoom",
    "{west}",
    "Reload",
],
    [
    "{north}",
    "Painkillers",
    "{lb}",
    "Hold: weapon groups",
],
    [
    "{l3}",
    "Click: crouch (toggle)",
    "{up}",
    "Best weapon",
],
    [
    "{left} {right}",
    "Previous / next weapon",
    "{start}",
    "Menu · double tap: quick save",
],
    [
    "{select}",
    "Pause",
    "hold {start}",
    "Quick load",
],
]

[info_overlays.style]
position = "center"
scale = 0.9

[info_overlays.style.background]
color = "#101214"
opacity = 0.88

[info_overlays.style.items]
color = "#2a2d31"
opacity = 0.95

[info_overlays.style.selected]
color = "#c9a227"
opacity = 1.0

[[layers]]
name = "Guide"
indicator = "bindings"
indicator_title = "Hold {guide} and press"
indicator_delay_ms = 250
swallow_unbound = true

[layers.indicator_style]
position = "bottom_left"
scale = 0.8

[layers.indicator_style.background]
color = "#16181c"
opacity = 0.85

[layers.indicator_style.items]
color = "#30343c"
opacity = 0.95

[layers.indicator_style.selected]
color = "#2f5db0"
opacity = 1.0

[layers.buttons]
East = "force_quit"
North = "toggle_numpad"
West = "toggle_overlay"
RightBumper = "screenshot"
LeftStick = "toggle_recording"
DpadUp = "next_profile"

[layers.buttons.DpadDown]
keys = ["KEY_TAB"]

[layers.buttons.DpadLeft]
keys = ["KEY_ESC"]

[layers.buttons.DpadRight]
keys = ["KEY_ENTER"]

[layers.right_stick]
deadzone = 0.1
curve = 2.0
key_threshold = 0.5

[layers.right_stick.action.mouse]
speed = 1600.0

[layers.left_trigger.action.button]
threshold = 0.3

[layers.left_trigger.action.button.action]
mouse = "Right"

[layers.right_trigger.action.button]
threshold = 0.3

[layers.right_trigger.action.button.action]
mouse = "Left"
