[[menus]]
name = "Weapons"

[menus.kind.radial]
stick = "Right"

[[menus.items]]
label = "Secondary"

[menus.items.action]
keys = ["KEY_1"]

[[menus.items]]
label = "Handguns"

[menus.items.action]
keys = ["KEY_2"]

[[menus.items]]
label = "Shotguns"

[menus.items.action]
keys = ["KEY_3"]

[[menus.items]]
label = "Submachine guns"

[menus.items.action]
keys = ["KEY_4"]

[[menus.items]]
label = "Assault rifles"

[menus.items.action]
keys = ["KEY_5"]

[[menus.items]]
label = "Sniper rifles"

[menus.items.action]
keys = ["KEY_6"]

[menus.style]
corners = 0.2
position = "center"
scale = 1.0

[menus.style.background]
color = "#1a1410"
opacity = 0.92

[menus.style.items]
color = "#3b2f24"
opacity = 0.95

[menus.style.selected]
color = "#d69a3c"
