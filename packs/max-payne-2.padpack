format = 13
macros = []
overlay_font = "Source Code Pro"

[pack]
id = "a3e96f08-81c7-4d2b-b5f3-6c0d47e9128a"
name = "Max Payne 2"
version = "1.1"
author = "padwight"
description = "Max Payne 2: The Fall of Max Payne (2003) on an Xbox-style pad, for the game's default keys. LT is bullet time, RB shoot-dodge (move + RB), LB opens a radial menu of weapon groups (aim with the right stick), R3 is the secondary attack, L3 toggles crouch, North takes painkillers. Hold Guide to see every control and the system shortcuts."
made_with = "Xbox controller"

[[rules]]
kind = "executable"
value = "maxpayne2.exe"
profile = "Max Payne 2"

[[rules]]
kind = "steam_app_id"
value = "12150"
profile = "Max Payne 2"

[[profiles]]
name = "Max Payne 2"
combos = []
combo_window_ms = 120
tap_window_ms = 250
long_press_ms = 500

[profiles.buttons]
[profiles.buttons.DpadDown]
keys = ["KEY_TAB"]

[profiles.buttons.South]
keys = ["KEY_SPACE"]

[profiles.buttons.East]
keys = ["KEY_E"]

[profiles.buttons.North]
keys = ["KEY_E"]

[profiles.buttons.West]
keys = ["KEY_R"]

[profiles.buttons.LeftBumper]
open_menu = "Weapons"

[profiles.buttons.RightBumper]
keys = ["KEY_LEFTSHIFT"]

[profiles.buttons.Select]
keys = ["KEY_P"]

[profiles.buttons.Start]
keys = ["KEY_ESC"]

[profiles.buttons.LeftStick.toggle]
keys = ["KEY_C"]

[profiles.buttons.RightStick]
keys = ["KEY_1"]

[profiles.buttons.DpadUp]
keys = ["KEY_G"]

[profiles.buttons.DpadLeft]
wheel = "Up"

[profiles.buttons.DpadRight]
wheel = "Down"

[profiles.left_stick]
deadzone = 0.12
curve = 1.0
key_threshold = 0.25

[profiles.left_stick.action.keys]
up = "KEY_W"
down = "KEY_S"
left = "KEY_A"
right = "KEY_D"

[profiles.right_stick]
deadzone = 0.1
curve = 1.8
key_threshold = 0.5

[profiles.right_stick.action.mouse]
speed = 1300.0
accel = 0.2

[profiles.left_trigger.action.button]
threshold = 0.4

[profiles.left_trigger.action.button.action]
mouse = "Right"

[profiles.right_trigger.action.button]
threshold = 0.3

[profiles.right_trigger.action.button.action]
mouse = "Left"

[profiles.gestures.Start.double_tap]
keys = ["KEY_F5"]

[profiles.gestures.Start.long_press]
keys = ["KEY_F9"]

[profiles.gestures.Guide.double_tap]
gamepad = "Guide"

[profiles.gyro]
mode = "off"
horizontal = "yaw"
invert_x = false
invert_y = false
activation = "always"
noise_threshold = 1.0
[profiles.guide.edits]
"stick:Left" = { text = "Move" }
"stick:Right" = { text = "Aim" }
"trigger:Left" = { text = "Bullet time" }
"button:RightBumper" = { text = "Shoot-dodge (move + {rb})" }
"button:RightStick" = { text = "Click: secondary attack" }
"trigger:Right" = { text = "Shoot" }
"button:South" = { text = "Jump" }
"button:East" = { text = "Use" }
"button:West" = { text = "Reload" }
"button:North" = { text = "Hold: sniper zoom" }
"button:LeftBumper" = { text = "Hold: weapon groups" }
"button:LeftStick" = { text = "Click: crouch (toggle)" }
"button:DpadUp" = { text = "Best weapon" }
"button:Start" = { text = "Menu" }
"gesture:button:Start:double_tap" = { text = "quick save" }
"button:Select" = { text = "Pause" }
"gesture:button:Start:long_press" = { text = "Quick load" }
"button:DpadDown" = { text = "Painkillers" }

[[profiles.guide.merged]]
inputs = ["button:DpadLeft", "button:DpadRight"]
text = "Previous / next weapon"




