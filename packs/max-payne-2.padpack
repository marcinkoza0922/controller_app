[menus.kind.radial]
stick = "Right"

[[menus.items]]
label = "Secondary"

[menus.items.action]
keys = ["KEY_1"]

[[menus.items]]
label = "Handguns"

[menus.items.action]
keys = ["KEY_2"]

[[menus.items]]
label = "Shotguns"

[menus.items.action]
keys = ["KEY_3"]

[[menus.items]]
label = "Submachine guns"

[menus.items.action]
keys = ["KEY_4"]

[[menus.items]]
label = "Assault rifles"

[menus.items.action]
keys = ["KEY_5"]

[[menus.items]]
label = "Sniper rifles"

[menus.items.action]
keys = ["KEY_6"]

[menus.style]
corners = 0.2
position = "center"
scale = 1.0

[menus.style.background]
color = "#1a1410"
opacity = 0.92

[menus.style.items]
color = "#3b2f24"
opacity = 0.95

[menus.style.selected]
color = "#d69a3c"
opacity = 1.0

[[info_overlays]]
name = "Controls"
title = "This game's controls"
always = false
rows = [
    [
    "{ls}",
    "Move",
    "{rs}",
    "Aim",
],
    [
    "{lt}",
    "Bullet time",
    "{rb}",
    "Shoot-dodge (move + {rb})",
],
    [
    "{r3}",
    "Click: secondary attack",
    "",
    "",
],
    [
    "{rt}",
    "Shoot",
    "{south}",
    "Jump",
],
    [
    "{east}",
    "Use",
    "{west}",
    "Reload",
],
    [
    "{north}",
    "Hold: sniper zoom",
    "{lb}",
    "Hold: weapon groups",
],
    [
    "{l3}",
    "Click: crouch (toggle)",
    "{up}",
    "Best weapon",
],
    [
    "{left} {right}",
    "Previous / next weapon",
    "{start}",
    "Menu · double tap: quick save",
],
    [
    "{select}",
    "Pause",
    "hold {start}",
    "Quick load",
],
    [
    "{down}",
    "Painkillers",
],
]

[info_overlays.style]
position = "center"
scale = 0.9

[info_overlays.style.background]
color = "#1a1410"
opacity = 0.88

[info_overlays.style.items]
color = "#3b2f24"
opacity = 0.95

[info_overlays.style.selected]
color = "#d69a3c"
opacity = 1.0

[[layers]]
name = "Guide"
indicator = "bindings"
indicator_title = "Hold {guide} and press"
indicator_delay_ms = 100
swallow_unbound = true

[layers.buttons]
East = "force_quit"
LeftStick = "toggle_recording"
RightBumper = "screenshot"
LeftBumper = "toggle_media"
West = "toggle_overlay"
North = "toggle_numpad"
DpadUp = "next_profile"

[layers.buttons.DpadRight]
keys = ["KEY_ENTER"]

[layers.buttons.DpadDown]
keys = ["KEY_TAB"]

[layers.buttons.DpadLeft]
keys = ["KEY_ESC"]

